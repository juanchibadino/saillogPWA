# Required public Supabase config (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional but recommended canonical app URL for magic-link redirects
# Local example: http://localhost:3000
# Production example: https://dockout.app
NEXT_PUBLIC_APP_URL=

# Optional server-only key for trusted admin operations
SUPABASE_SECRET_KEY=

# Optional project ref used by CLI scripts and tooling
SUPABASE_PROJECT_REF=

# Transactional email notifications
RESEND_API_KEY=
# Verified Resend sender email. The app sends it with the visible name "Dock Out".
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_REPLY_TO=

# Web Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Polar subscription
# POLAR_SERVER defaults to sandbox when empty. Use "production" for live billing.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_MONTHLY_PRODUCT_ID=

# Legacy fallbacks (optional)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
